# Required: list all PNR entries here (JSON array)
# - id: label shown in notifications
# - pnr: plain 10-digit PNR (used by fallback providers)
# - emt_pnr_token: encrypted token for EaseMyTrip (recommended)
PNR_LIST_JSON=[{"id":"trip-home","pnr":"1234567890","emt_pnr_token":"<encrypted_emt_token_here>"}]

# Optional: additional headers for EaseMyTrip request
# Leave as {} for current no-token usage.
EMT_HEADERS_JSON={}

# Optional: RapidAPI fallback provider
# Preferred: provide multiple keys for automatic key rotation when limit is hit.
# Example: RAPIDAPI_KEYS_JSON=["key1","key2","key3"]
RAPIDAPI_KEYS_JSON=[]
RAPIDAPI_KEY=

# Optional: ntfy notifications
NTFY_TOPIC=
NTFY_TOKEN=

# Optional: Resend email notifications
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_TO_EMAIL=

# Optional: custom state file path
STATE_FILE=state/pnr_state.json
